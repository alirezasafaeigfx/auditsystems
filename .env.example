# AuditSystems — Environment Variables
# Copy this to .env and fill in values.

# ─── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE_NAME"

# ─── Security Secrets (REQUIRED) ───────────────────────────
# Generate with: openssl rand -hex 32
IP_HASH_SALT=""
CSRF_SECRET=""
SESSION_SECRET=""
DOWNLOAD_TOKEN_SECRET=""
ADMIN_SESSION_SECRET=""

# ─── Audit Scanner ─────────────────────────────────────────
AUDIT_DNS_GUARD="true"
AUDIT_DNS_FAIL_OPEN="false"
WORKER_POLL_MS="1200"
WORKER_JOB_TIMEOUT_MS="45000"
WORKER_CONCURRENCY="1"

# ─── Distributed Rate Limiting ─────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL=""
REQUIRE_DISTRIBUTED_RATE_LIMIT="false"

# Authentication endpoints fail closed in production unless the trusted
# ingress contract below is explicitly enabled. The ingress must strip and
# overwrite the selected header and prevent clients from bypassing the proxy.
AUTH_TRUST_PROXY_HEADERS="false"
# Allowed values when trust is enabled: x-forwarded-for or x-real-ip
AUTH_CLIENT_IP_HEADER=""

# ─── App Routing ───────────────────────────────────────────
# MOCK is development/test only. Production must use ZARINPAL.
PAYMENT_PROVIDER_DEFAULT="MOCK"
# APP_BASE_URL is set in production environment
APP_BASE_URL_STRICT="false"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Team Invite Delivery ──────────────────────────────────
# Required for invite creation/resend. Production requires HTTPS for both URLs.
# The webhook receives a bearer-authenticated JSON payload containing the destination email and invite URL.
TEAM_INVITE_DELIVERY_WEBHOOK_URL=""
TEAM_INVITE_DELIVERY_WEBHOOK_SECRET=""

# ─── Payments (optional) ──────────────────────────────────
ZARINPAL_MERCHANT_ID=""

# ─── Analytics (optional) ─────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Admin Auth ────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
